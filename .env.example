# Copy this file to .env and fill it in. .env is deliberately NOT tracked
# by git, so each machine keeps its own values across a deploy.
NODE_ENV=
PORT=
# The canonical URL the app is served from, scheme included, no trailing
# slash (e.g. https://chess.example.com). Account emails link to it, and
# requests arriving on this hostname are trusted.
ORIGIN=
# Any further URLs the same deployment answers on, comma separated. A
# request whose hostname is on neither list is refused with a 401, so a
# second subdomain has to be named here or it cannot reach the app.
ADDITIONAL_ORIGINS=
AUTH_SECRET=
INTERNAL_PASSWORD=
ANALYSIS_SESSION_ACTIONS=
MAXIMUM_ARCHIVE_SIZE=1000

# Resource tuning. The defaults suit a server shared with other services;
# raise them on a machine dedicated to this app.
#
# Cluster workers. Each is a full Node process, so this multiplies the
# server's baseline memory use. Default: 2
SERVER_WORKERS=
# Total Stockfish processes across the whole server. Each costs ~300 MB
# resident, and they are spawned on demand and terminated once idle.
# Default: 2
SERVER_ENGINE_PROCESSES=
# Search threads per engine. Default: half the cores, split between
# engines, capped at 4
SERVER_ENGINE_THREADS=
# Transposition table per engine, in MB. Default: 32
SERVER_ENGINE_HASH=
# How long an unused engine lingers before being shut down, in ms.
# Default: 30000
SERVER_ENGINE_IDLE_MS=
# Request body ceiling for analysed games. A long game analysed at high
# depth with 5 lines can exceed 1 MB. Default: 4mb
ANALYSIS_BODY_LIMIT=
# Mongo connection pool size per worker. Default: 10
DATABASE_POOL_SIZE=
# Hard memory ceiling for the app container. Default: 2g
APP_MEMORY_LIMIT=
